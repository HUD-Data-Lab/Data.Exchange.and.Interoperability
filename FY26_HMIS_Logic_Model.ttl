# ---------------------------------------------------------------------------------------------
# String datatypes with the field rules of the HUD FY 2026 HMIS CSV Specifications.
# xsd:pattern values are XSD regular expressions, implicitly anchored to the whole string.
# ---------------------------------------------------------------------------------------------

:cocCodeString a rdfs:Datatype ;
    rdfs:label "CoC code string"@en ;
    rdfs:comment "A Continuum of Care code: two letters, a dash, and three digits (for example XX-500). HUD FY 2026 HMIS CSV Specifications: CoCCode is S6, two letters, a dash, and 3 numbers (2.03.1, 2.07.3)."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "[a-zA-Z]{2}-[0-9]{3}" ] [ xsd:maxLength 6 ] ) ] .

:zipCodeString a rdfs:Datatype ;
    rdfs:label "ZIP code string"@en ;
    rdfs:comment "A five-digit US ZIP code. HUD FY 2026 HMIS CSV Specifications: 2.03.7 ZIP is S5."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "[0-9]{5}" ] ) ] .

:stateCodeString a rdfs:Datatype ;
    rdfs:label "state code string"@en ;
    rdfs:comment "A two-letter USPS state abbreviation. HUD FY 2026 HMIS CSV Specifications: 2.03.6 State is S2."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "[a-zA-Z]{2}" ] ) ] .

:string5 a rdfs:Datatype ;
    rdfs:label "string5"@en ;
    rdfs:comment "A string of at most 5 characters, the S5 field type of the HUD FY 2026 HMIS CSV Specifications."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:maxLength 5 ] ) ] .

:string32 a rdfs:Datatype ;
    rdfs:label "string32"@en ;
    rdfs:comment "A string of at most 32 characters, the S32 field type of the HUD FY 2026 HMIS CSV Specifications."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:maxLength 32 ] ) ] .

:string50 a rdfs:Datatype ;
    rdfs:label "string50"@en ;
    rdfs:comment "A string of at most 50 characters, the S50 field type of the HUD FY 2026 HMIS CSV Specifications."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:maxLength 50 ] ) ] .

:string100 a rdfs:Datatype ;
    rdfs:label "string100"@en ;
    rdfs:comment "A string of at most 100 characters, the S100 field type of the HUD FY 2026 HMIS CSV Specifications."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:maxLength 100 ] ) ] .

:string250 a rdfs:Datatype ;
    rdfs:label "string250"@en ;
    rdfs:comment "A string of at most 250 characters, the S250 field type of the HUD FY 2026 HMIS CSV Specifications."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:maxLength 250 ] ) ] .

:string320 a rdfs:Datatype ;
    rdfs:label "string320"@en ;
    rdfs:comment "A string of at most 320 characters, the S320 field type of the HUD FY 2026 HMIS CSV Specifications."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:maxLength 320 ] ) ] .

:string500 a rdfs:Datatype ;
    rdfs:label "string500"@en ;
    rdfs:comment "A string of at most 500 characters, the S500 field type of the HUD FY 2026 HMIS CSV Specifications."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:maxLength 500 ] ) ] .

xsd:gYear a rdfs:Datatype .

:AssessmentQuestionID a owl:DatatypeProperty ;
    rdfs:label "AssessmentQuestionID" ;
    rdfs:domain :AssessmentQuestionClass ;
    rdfs:range :string32 ;
    rdfs:subPropertyOf owl:topDataProperty .

:CoCCode a owl:DatatypeProperty ;
    dcterms:description "Continuum Code - HUD-assigned CoC codes for the project location" ;
    dcterms:identifier "2.03.1",
        "2.07.3" ;
    rdfs:domain :ProjectCoC ;
    rdfs:range :cocCodeString ;
    :responseNotes """Two letters, a dash, and 3 numbers
^[a-zA-Z]{2}-[0-9]{3}$""" .

:DateOfEngagementClass a owl:Class ;
    dcterms:identifier 4.13 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :ProjectID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :HouseholdID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty :DateOfEngagement ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    :CSVTableReference "Enrollment" .

:DisabilityResponse a owl:ObjectProperty ;
    rdfs:domain :Disabilities ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_DisabilityResponse, :list_NoYesReasonsForMissing ;
    :responseNotes "For DisabilityType = 10 (Substance Use Disorder) use hmis:responseValue. Any other use hmis:responseValueSecondary" ;
    :responseValue "0=No;1=Alcohol use disorder;2=Drug use disorder; 3=Both alcohol and drug use disorders; 8=Client doesn't know; 9=Client prefers not to answer;99=Data not collected" ;
    :responseValueSecondary "0=No;1=Yes;8=Client doesn’t know;9=Client prefers not to answer;99=Data not collected" .

:EmploymentEducationID a owl:DatatypeProperty ;
    rdfs:label "EmploymentEducationID" ;
    rdfs:domain :Education,
        :Employment ;
    rdfs:range :string32 .

:HealthAndDVID a owl:DatatypeProperty ;
    rdfs:label "HealthAndDVID" ;
    rdfs:domain :DomesticViolence,
        :HealthStatus ;
    rdfs:range :string32 ;
    rdfs:subPropertyOf owl:topDataProperty .

:Household a owl:Class ;
    dcterms:description "Automatically generated identifier created by the HMIS software. A Household Identifier must be permanent and unique to a single household at each project start within an HMIS. The Household ID has no meaning beyond a single ‘household enrollment’; it is used in conjunction with the 2.02.1 Project ID, 3.10 Project Start Date, and 3.11 Project Exit Date to link records for household members together and indicate that they were served together." ;
    dcterms:identifier 5.09 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :ProjectID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :HouseholdID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ] ;
    :CSVTableReference "Enrollment" .

:MoveInDate a owl:Class,
        owl:DatatypeProperty ;
    dcterms:description "Housing Move-In Date" ;
    dcterms:identifier "3.20.1" ;
    rdfs:domain :MoveInDate ;
    rdfs:range xsd:date ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange :string32 ;
            owl:onProperty :UserID ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :DateUpdated ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :DateDeleted ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty :DateCreated ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:OrganizationID a owl:DatatypeProperty ;
    dcterms:identifier "2.01.1" ;
    rdfs:label "OrganizationID" ;
    rdfs:domain :Organization ;
    rdfs:range :string32 ;
    rdfs:subPropertyOf owl:topDataProperty .

:Affiliation a owl:Class ;
    dcterms:description "Affiliation represents the association between projects with a project type of 6 (Services Only) or project type 13 subtype 1 (RRH Services Only) and lodging projects." ;
    dcterms:identifier "2.02C" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onDataRange :string32 ;
            owl:onProperty :AffiliationID ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :ProjectID ;
            owl:someValuesFrom :string32 ] ;
    :CSVTableReference "Affiliation" .

:AssessmentID a owl:DatatypeProperty ;
    rdfs:label "AssessmentID" ;
    rdfs:domain :Assessment ;
    rdfs:range :string32 ;
    rdfs:subPropertyOf owl:topDataProperty .

:ExitHousingAssessmentClass a owl:Class ;
    dcterms:description "indicates whether clients exiting any HOPWA component type remain stably housed as of exit." ;
    dcterms:identifier "W5" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :ExitHousingAssessment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :ExitID ;
            owl:someValuesFrom :string32 ] ;
    :CSVTableReference "Exit" .

:VASHExitReason a owl:Class ;
    dcterms:identifier "V9" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ExitID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :CMExitReason ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ] ;
    :CSVTableReference "Exit" .

:AssessmentResultClass a owl:Class ;
    dcterms:description "Locally defined; Results structured as defined by the community" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :AssessmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
