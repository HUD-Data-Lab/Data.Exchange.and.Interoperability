:Enrollment a owl:Class ;
    dcterms:description "Includes data elements associated with HMIS metadata element 5.06 EnrollmentID that have one and only one value per enrollment record and that are collected prior to project exit." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty :EntryDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :DisablingCondition ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Exit ;
            owl:onProperty :hasExit ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :RelationshipToHoH ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :ProjectID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :HouseholdID ;
            owl:someValuesFrom :string32 ] ;
    :CSVTableReference "Enrollment" .

:DateCreated a owl:DatatypeProperty ;
    dcterms:description "Date Created" ;
    dcterms:identifier "5.01.1" ;
    rdfs:domain :Metadata ;
    rdfs:range xsd:dateTime .

:DateDeleted a owl:DatatypeProperty ;
    dcterms:description "If the intended record is to be deleted, this metadata allows you to both indicate the record should be deleted within the target system, as well as indicate the specific time it was deleted." ;
    rdfs:domain :Metadata ;
    rdfs:range xsd:dateTime .

:DateUpdated a owl:DatatypeProperty ;
    dcterms:description "Date Updated" ;
    dcterms:identifier "5.02.1" ;
    rdfs:domain :Metadata ;
    rdfs:range xsd:dateTime .

:ExportID a owl:DatatypeProperty ;
    dcterms:identifier "FW.5" ;
    rdfs:label "ExportID" ;
    rdfs:domain :Export ;
    rdfs:range :string32 ;
    rdfs:subPropertyOf owl:topDataProperty .

:UserID a owl:DatatypeProperty ;
    dcterms:description "A unique ID used to associate data with the user who entered and/or edited it." ;
    dcterms:identifier "5.07.01",
        "5.07.1" .

xsd:date a rdfs:Datatype .

xsd:dateTime a rdfs:Datatype .


#################################################################
#  Proposed additions from v1.3.0-beta
#  Content from Artifacts/Ontology/Output_v1.3.0-beta/hmis_ontologyv1.3.0-beta.ttl
#  that the FY2026 Logic Model lacks, rewritten in this model's conventions.
#  Left out on purpose: Sub* grouping classes, disjointness axioms, the C4
#  Translation Assistance fields (removed from the FY2026 standards), and the
#  SKOS code lists (this model already defines each list as an rdfs:Datatype).
#################################################################

# --- FY2026 data elements missing from the Logic Model -------------------------

:HOHLeaseholder a owl:ObjectProperty ;
    rdfs:label "HOHLeaseholder" ;
    dcterms:description "Head of Household is a current leaseholder/renter of unit" ;
    dcterms:identifier "V7.E" ;
    rdfs:domain :EntrySSVF ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_NoYesMissing ;
    :responseValue "0=No;1=Yes;99=Data not collected" .

:MentalHealthConsultation a owl:ObjectProperty ;
    rdfs:label "MentalHealthConsultation" ;
    dcterms:description "Mental Health Consultation Status (new in FY2026). Collected at project start for all Veterans in VA: SSVF RRH and Homelessness Prevention, and VA: GPD Case Management/Housing Retention projects. No more than one per enrollment." ;
    dcterms:identifier "V10" ;
    rdfs:domain :EntrySSVF ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_MentalHealthConsultation ;
    :responseValue "1=Mental health consultation completed;2=Mental health consultation being coordinated/arranged with VA provider;3=Mental health consultation being coordinated/arranged with other provider;4=Offer declined" .

:EntrySSVF rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass skos:Concept ;
            owl:onProperty :MentalHealthConsultation ] .

:FunderClass rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:date ;
            owl:onProperty :GrantEndDate ] .

# --- Part-of property hierarchy -------------------------------------------------
# The beta grouped record types under SubEnrollment / SubProject / SubCEAssessment
# classes. The same grouping is expressed here on the relationships instead: every
# compositional has* property is a sub-property of :hasPart, so a reasoner can
# answer "all parts of this enrollment / project / assessment" in one query.

:hasPart a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "Links a record to a record that exists only as part of it, such as an enrollment to its assessments, services and exit, or a project to its funders and inventory."@en ;
    owl:inverseOf :partOf .

:partOf a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "part of"@en ;
    rdfs:comment "Links a record to the one record it is part of. Functional: each part belongs to exactly one whole."@en ;
    owl:inverseOf :hasPart .

:hasAffiliation rdfs:subPropertyOf :hasPart .
:hasCEParticipation rdfs:subPropertyOf :hasPart .
:hasFunder rdfs:subPropertyOf :hasPart .
:hasHMISParticipation rdfs:subPropertyOf :hasPart .
:hasInventory rdfs:subPropertyOf :hasPart .
:hasProjectCoC rdfs:subPropertyOf :hasPart .

:hasClientVeteranInfo rdfs:subPropertyOf :hasPart .

:hasAssessment rdfs:subPropertyOf :hasPart .
:hasConnectionWithSOAR rdfs:subPropertyOf :hasPart .
:hasCurrentLivingSituation rdfs:subPropertyOf :hasPart .
:hasDateOfEngagement rdfs:subPropertyOf :hasPart .
:hasDisabilities rdfs:subPropertyOf :hasPart .
:hasDomesticViolence rdfs:subPropertyOf :hasPart .
:hasEducation rdfs:subPropertyOf :hasPart .
:hasEmployment rdfs:subPropertyOf :hasPart .
:hasEntryRHY rdfs:subPropertyOf :hasPart .
:hasEntrySSVF rdfs:subPropertyOf :hasPart .
:hasEvent rdfs:subPropertyOf :hasPart .
:hasExit rdfs:subPropertyOf :hasPart .
:hasHealthInsurance rdfs:subPropertyOf :hasPart .
:hasHealthStatus rdfs:subPropertyOf :hasPart .
:hasIncomeAndSources rdfs:subPropertyOf :hasPart .
:hasMedicalAssistance rdfs:subPropertyOf :hasPart .
:hasMoveInDate rdfs:subPropertyOf :hasPart .
:hasNonCashBenefits rdfs:subPropertyOf :hasPart .
:hasPATHStatus rdfs:subPropertyOf :hasPart .
:hasRHYBCPStatus rdfs:subPropertyOf :hasPart .
:hasServiceFAReferral rdfs:subPropertyOf :hasPart .
:hasYouthEducationStatus rdfs:subPropertyOf :hasPart .

:hasExitHousingAssessment rdfs:subPropertyOf :hasPart .
:hasExitRHY rdfs:subPropertyOf :hasPart .
:hasRhyAftercare rdfs:subPropertyOf :hasPart .
:hasVASHExitReason rdfs:subPropertyOf :hasPart .

:hasAssessmentQuestion rdfs:subPropertyOf :hasPart .
:hasAssessmentResult rdfs:subPropertyOf :hasPart .

# --- Inverses for the non-compositional links -----------------------------------
# The beta declared inverse pairs (organizationOf, clientOf, projectOf, householdOf).
# Each enrollment has exactly one client, project and household, and each project
# exactly one organization, so the inverses are functional.

:operatedBy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "operated by"@en ;
    rdfs:comment "Links a project to the organization that operates it (2.02.2 OrganizationID)."@en ;
    rdfs:domain :Project ;
    rdfs:range :Organization ;
    owl:inverseOf :hasProject .

:enrollmentOfClient a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "enrollment of client"@en ;
    rdfs:comment "Links an enrollment to the client enrolled (PersonalID)."@en ;
    rdfs:domain :Enrollment ;
    rdfs:range :Client ;
    owl:inverseOf :hasClientEnrollment .

:enrollmentInProject a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "enrollment in project"@en ;
    rdfs:comment "Links an enrollment to the project it is in (ProjectID)."@en ;
    rdfs:domain :Enrollment ;
    rdfs:range :Project ;
    owl:inverseOf :hasProjectEnrollment .

:enrollmentInHousehold a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "enrollment in household"@en ;
    rdfs:comment "Links an enrollment to its household (5.09 HouseholdID)."@en ;
    rdfs:domain :Enrollment ;
    rdfs:range :Household ;
    owl:inverseOf :hasHouseholdEnrollment .

