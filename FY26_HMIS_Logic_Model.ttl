# --- Descriptions for classes that had none ------------------------------------

:DateOfEngagementClass dcterms:description "Contains data for element 4.13 Date of Engagement, exported in Enrollment.csv." .
:EntryRHY dcterms:description "Runaway and Homeless Youth (RHY) data collected at project start, exported in Enrollment.csv." .
:EntrySSVF dcterms:description "VA program data collected at project start, exported in Enrollment.csv: V7 HP Targeting Criteria and V10 Mental Health Consultation." .
:Event dcterms:description "Contains data for element 4.20 Coordinated Entry Event, exported in Event.csv." .
:ExitRHY dcterms:description "Runaway and Homeless Youth (RHY) data collected at project exit, exported in Exit.csv." .
:Export dcterms:description "Describes one HMIS CSV export: its source, reporting period and export parameters (Export.csv)." .
:ServiceFAReferral dcterms:description "Services, financial assistance and referrals provided during an enrollment, exported in Services.csv." .
:VASHExitReason dcterms:description "Contains data for element V9 HUD-VASH Exit Information, exported in Exit.csv." .

#################################################################
#  Code lists as SKOS concept schemes
#  One skos:ConceptScheme per HMIS list (:csvList is the list number in the HUD FY2026 CSV
#  specification) and one skos:Concept per value. Concept IRIs are scoped to their scheme
#  (:list_<Name>_<notation>), so every concept has exactly one skos:inScheme, skos:notation and
#  skos:prefLabel. Scheme names follow the v1.3.0-beta ontology.
#################################################################

:csvList a owl:AnnotationProperty ;
    rdfs:label "csv list"@en ;
    rdfs:comment "The number of the list in the HUD HMIS CSV specification."@en .

:linkedVocabulary a owl:AnnotationProperty ;
    rdfs:label "linked vocabulary"@en ;
    rdfs:comment "The skos:ConceptScheme whose concepts are the allowed values of a property."@en .

