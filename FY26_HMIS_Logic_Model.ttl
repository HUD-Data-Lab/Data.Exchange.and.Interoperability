:CLSSubsidyType a owl:ObjectProperty ;
    dcterms:description "Rental Subsidy Type" ;
    dcterms:identifier "4.12.A" ;
    rdfs:domain :CurrentLivingSituationClass ;
    rdfs:range skos:Concept ;
