            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onDataRange :3.12.1 ;
            owl:onProperty :Destination ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :VASHExitReason ;
            owl:onProperty :hasVASHExitReason ] ;
    :CSVTableReference "Exit" .

:ServiceFAReferral a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onDataRange :C2.2 ;
                        owl:onProperty :TypeProvided ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange :P1.2 ;
                        owl:onProperty :TypeProvided ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange :P2.2 ;
                        owl:onProperty :TypeProvided ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange :R14.2 ;
                        owl:onProperty :TypeProvided ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange :V2.2 ;
                        owl:onProperty :TypeProvided ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange :V3.4 ;
                        owl:onProperty :TypeProvided ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange :V8.2 ;
                        owl:onProperty :TypeProvided ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange :W1.2 ;
                        owl:onProperty :TypeProvided ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange :W2.2 ;
                        owl:onProperty :TypeProvided ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange :4.14 ;
                        owl:onProperty :TypeProvided ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateProvided ;
            owl:someValuesFrom xsd:date ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onDataRange :1.4 ;
            owl:onProperty :RecordType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ] ;
    :CSVTableReference "Services" .

:5.03.1 a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "Annual assessment" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "Project entry" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Project exit" ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "Update" ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first 1 ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first 2 ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first 3 ;
                                                                    rdf:rest [ a rdf:List ;
                                                                            rdf:first 5 ;
                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] .

:Disabilities a owl:Class ;
    dcterms:description "To indicate whether clients have a disability or other health condition that contributes to their experience of homelessness or may be a factor in housing." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DisabilitiesID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onDataRange :1.8 ;
                        owl:onProperty :DisabilityResponse ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onDataRange :4.10.2 ;
                        owl:onProperty :DisabilityResponse ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :InformationDate ;
            owl:someValuesFrom xsd:date ],
        [ a owl:Restriction ;
            owl:onDataRange :5.03.1 ;
            owl:onProperty :DataCollectionStage ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange :1.3 ;
            owl:onProperty :DisabilityType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ] ;
    :CSVTableReference "Disabilities" .

:ProjectID a owl:DatatypeProperty ;
    rdfs:label "ProjectID" ;
    dcterms:description "Project Identifier" ;
