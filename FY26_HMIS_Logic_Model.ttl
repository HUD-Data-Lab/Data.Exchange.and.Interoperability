:AssessmentResultType a owl:DatatypeProperty ;
    dcterms:description "Assessment Result Type – Local determination - as defined by the community" ;
    dcterms:identifier "4.19.6" ;
    rdfs:domain :AssessmentResultClass ;
    rdfs:range :string250 ;
    rdfs:subPropertyOf owl:topDataProperty .

:AssessmentType a owl:ObjectProperty ;
    dcterms:description "Assessment Type" ;
    dcterms:identifier "4.19.3" ;
    rdfs:domain :Assessment ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_AssessmentType ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    :responseValue "1=Phone;2=Virtual;3=In Person" .

:Availability a owl:ObjectProperty ;
    dcterms:description "Availability" ;
    dcterms:identifier "2.07.6" ;
    rdfs:domain :Inventory ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_Availability ;
    :responseValue "1=Year-round;2=Seasonal;3=Overflow" .

:BlackAfAmerican a owl:ObjectProperty ;
    dcterms:description "Black, African American, or African" ;
    dcterms:identifier "3.04.1" ;
    rdfs:domain :Client ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_NoYes ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    :responseValue "0=No;1=Yes" .

