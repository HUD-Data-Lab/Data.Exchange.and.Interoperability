skos:note a owl:AnnotationProperty .

:GrantEndDate a owl:DatatypeProperty ;
    rdfs:label "GrantEndDate" ;
    rdfs:comment "The EndDate column of Funder.csv (2.06.4). Named GrantEndDate so it is not mistaken for an enrollment, project or service end date."@en ;
    dcterms:description "Grant End Date" ;
    dcterms:identifier "2.06.4" ;
    rdfs:domain :FunderClass ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf owl:topDataProperty .

: a owl:Ontology ;
    dc:creator "HUD Data Lab"@en ;
    dc:language "en-US"@en ;
    dc:title "HUD HMIS Logical Model"@en ;
    dcterms:description "The logical model for the US Department of Housing and Urban Development Homeless Management Information System FY2026 Data Standards"@en ;
    owl:versionIRI <https://github.com/HUD-Data-Lab/HMIS-Logic-Model/blob/main/urn_hud_hmis_owl.owl> ;
    owl:versionInfo "FY2026v1.2.0"@en .

:AccessPoint a owl:ObjectProperty ;
    rdfs:label "AccessPoint" ;
    dcterms:description "Project is a Coordinated Entry Access Point" ;
    dcterms:identifier "2.09.1" ;
    rdfs:domain :CEParticipation ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_NoYes ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    :responseValue "0=No;1=Yes" .

:AdditionalRaceEthnicity a owl:DatatypeProperty ;
    rdfs:label "AdditionalRaceEthnicity" ;
    dcterms:description "Additional Race and Ethnicity Detail" ;
    dcterms:identifier "3.04.2" ;
    rdfs:domain :Client ;
    rdfs:range :string100 ;
    rdfs:subPropertyOf owl:topDataProperty .

:Address1 a owl:DatatypeProperty ;
    dcterms:description "Project street address 1" ;
    dcterms:identifier "2.03.3" ;
    rdfs:domain :ProjectCoC ;
    rdfs:range :string100 .

:Address2 a owl:DatatypeProperty ;
    dcterms:description "Project street address 2" ;
    dcterms:identifier "2.03.4" ;
    rdfs:domain :ProjectCoC ;
    rdfs:range :string100 .

:AfghanistanOEF a owl:ObjectProperty ;
    dcterms:description "Theatre of Operations: Afghanistan (Operation Enduring Freedom)" ;
    dcterms:identifier "V1.7" ;
    rdfs:domain :ClientVeteranInfo ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_NoYesReasonsForMissing ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    :responseValue "0=No;1=Yes;8=Client doesn’t know;9=Client prefers not to answer;99=Data not collected" .

:AlimonyAmount a owl:DatatypeProperty ;
    dcterms:description "Monthly Amount" ;
    dcterms:identifier "4.02.N" ;
    rdfs:domain :IncomeAndSources ;
    rdfs:range xsd:decimal .

:AmIndAKNative a owl:ObjectProperty ;
    dcterms:description "American Indian, Alaska Native, or Indigenous" ;
    dcterms:identifier "3.04.1" ;
    rdfs:domain :Client ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_NoYes ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    :responseValue "0=No;1=Yes" .

:AnnualPercentAMI a owl:ObjectProperty ;
    dcterms:description "Current household income" ;
    dcterms:identifier "V7.B" ;
    rdfs:domain :EntrySSVF ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_AnnualPercentAMI ;
    :responseValue "0=$0 (i.e., not employed, not receiving cash benefits, no other current income);1=1-14% of Area Median Income (AMI) for household size;2=15-30% of AMI for household size;3=More than 30% of AMI for household size;99=Data not collected" .

:AntiRetroviral a owl:ObjectProperty ;
    dcterms:description "Has the participant been prescribed anti-retroviral drugs?" ;
    dcterms:identifier "W6.2" ;
    rdfs:domain :Disabilities ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_NoYesReasonsForMissing ;
    :responseValue "0=No;1=Yes;8=Client doesn’t know;9=Client prefers not to answer;99=Data not collected" .

:Asian a owl:ObjectProperty ;
    dcterms:description "Asian or Asian American" ;
    dcterms:identifier "3.04.1" ;
    rdfs:domain :Client ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_NoYes ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    :responseValue "0=No;1=Yes" .

:AskedOrForcedToExchangeForSex a owl:ObjectProperty ;
    dcterms:description "Ever made/persuaded/forced to have sex in exchange for something" ;
    dcterms:identifier "R15.C" ;
    rdfs:domain :ExitRHY ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_NoYesReasonsForMissing ;
    :responseValue "0=No;1=Yes;8=Client doesn’t know;9=Client prefers not to answer;99=Data not collected" .

:AskedOrForcedToExchangeForSexPastThreeMonths a owl:ObjectProperty ;
    dcterms:description "In the last three months?" ;
    dcterms:identifier "R15.D" ;
    rdfs:domain :ExitRHY ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_NoYesReasonsForMissing ;
    :responseValue "0=No;1=Yes;8=Client doesn’t know;9=Client prefers not to answer;99=Data not collected" .

:AssessmentAnswer a owl:DatatypeProperty ;
    dcterms:description "Assessment answers - Local determination – responses to questions defined by community" ;
    dcterms:identifier "4.19.A" ;
    rdfs:domain :AssessmentQuestionClass ;
    rdfs:range :string500 ;
    rdfs:subPropertyOf owl:topDataProperty .

:AssessmentDate a owl:DatatypeProperty ;
    dcterms:description "Date of assessment" ;
    dcterms:identifier "4.19.1" ;
    rdfs:domain :Assessment ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf owl:topDataProperty .

:AssessmentLevel a owl:ObjectProperty ;
    dcterms:description "Assessment Level" ;
    dcterms:identifier "4.19.4" ;
    rdfs:domain :Assessment ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_AssessmentLevel ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    :responseValue "1=Crisis Needs Assessment;2=Housing Needs Assessment" .

:AssessmentLocation a owl:DatatypeProperty ;
    dcterms:description "Assessment location" ;
    dcterms:identifier "4.19.2" ;
    rdfs:domain :Assessment ;
    rdfs:range :string250 ;
    rdfs:subPropertyOf owl:topDataProperty .

:AssessmentQuestion a owl:DatatypeProperty ;
    dcterms:description "Assessment questions – Local determination - as defined by the community" ;
    dcterms:identifier "4.19.5" ;
    rdfs:domain :AssessmentQuestionClass ;
    rdfs:range :string250 ;
    rdfs:subPropertyOf owl:topDataProperty .

:AssessmentQuestionGroup a owl:DatatypeProperty ;
    dcterms:description "Locally determined" ;
    rdfs:domain :AssessmentQuestionClass ;
    rdfs:range :string250 ;
    rdfs:subPropertyOf owl:topDataProperty .

:AssessmentQuestionOrder a owl:DatatypeProperty ;
