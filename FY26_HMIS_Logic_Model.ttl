            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :AssessmentResultID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ] ;
    :CSVTableReference "AssessmentResults" .

:ConnectionWithSOAR a owl:Class,
        owl:ObjectProperty ;
    dcterms:description "Intended to determine if the client has been connected to the SSI/SSDI Outreach, Access, and Recovery (SOAR) program, regardless of whether that connection was established by the PATH provider or not." ;
    dcterms:identifier "P4.1" ;
    rdfs:domain :ConnectionWithSOAR ;
    rdfs:range skos:Concept ;
    :linkedVocabulary :list_NoYesReasonsForMissing ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :DataCollectionStage ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :IncomeBenefitsID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty :InformationDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :ConnectionWithSOAR ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    :responseValue "0=No;1=Yes;8=Client doesn’t know;9=Client prefers not to answer;99=Data not collected" .

:Education a owl:Class ;
    dcterms:description "Identify the educational attainment of youth served in RHY projects as well as, when appropriate, measure a change in education from project start to project exit for all Head of Households and youth" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :InformationDate ;
            owl:someValuesFrom xsd:date ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :EmploymentEducationID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :DataCollectionStage ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ] ;
    :CSVTableReference "EmploymentEducation" .

:PATHStatus a owl:Class ;
    dcterms:description "Used to determine whether a client is eligible for the PATH program" ;
    dcterms:identifier "P3" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty :DateOfPATHStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :ClientEnrolledInPATH ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ] ;
    :CSVTableReference "Enrollment" .

:DomesticViolence a owl:Class ;
    dcterms:description """To identify if a person is a survivor of or fleeing from domestic violence. Ascertaining whether a person is a survivor of or fleeing from domestic violence is 
necessary to provide the person with the appropriate services to prevent further abuse and to treat the physical and psychological injuries from prior abuse. Also, ascertaining that a person may be experiencing domestic violence may be important for the safety of project staff and other clients.""" ;
    dcterms:identifier 4.11 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :InformationDate ;
            owl:someValuesFrom xsd:date ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :HealthAndDVID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :DataCollectionStage ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom :string32 ] ;
    :CSVTableReference "HealthAndDV" .

:Employment a owl:Class ;
    dcterms:description "Designed to assess a client’s employment status and need for employment services as well as, when appropriate, measure a change in employment from project start to project exit for all Head of Households and adults." ;
    dcterms:identifier "R6" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :Employed ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :DataCollectionStage ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :EmploymentEducationID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ] ;
    :CSVTableReference "EmploymentEducation" .

:ExitID a owl:DatatypeProperty ;
    rdfs:label "ExitID" ;
    dcterms:description "unique identifier for the Exit.csv file of the HMIS CSV export format." ;
    rdfs:domain :Exit ;
    rdfs:range :string32 ;
    rdfs:subPropertyOf owl:topDataProperty .

:HMISParticipation a owl:Class ;
    dcterms:description "identifies the HMIS or comparable database participation status of each Continuum project." ;
    dcterms:identifier 2.08 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :HMISParticipationID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :ProjectID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ] ;
    :CSVTableReference "HMISParticipation" .

:HouseholdID a owl:DatatypeProperty ;
    dcterms:description "Household Identifier" ;
    dcterms:identifier "5.09",
        "5.09.1" ;
    rdfs:domain :Household .

:IncomeBenefitsID a owl:DatatypeProperty ;
    rdfs:label "IncomeBenefitsID" ;
    dcterms:description "unique identifier for the IncomeBenefits.csv file of the HMIS CSV export format." ;
    rdfs:domain :ConnectionWithSOAR,
        :HealthInsurance,
        :IncomeAndSources,
        :MedicalAssistance,
        :NonCashBenefits ;
    rdfs:range :string32 ;
    rdfs:subPropertyOf owl:topDataProperty .

:Organization a owl:Class ;
    dcterms:description "includes all the fields from HMIS data element 2.01 Organization Information." ;
    dcterms:identifier 2.01 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :OrganizationID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :VictimServiceProvider ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onDataRange :string50 ;
            owl:onProperty :OrganizationName ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    :CSVTableReference "Organization" .

:RHYBCPStatus a owl:Class ;
    dcterms:description """This element serves a three-fold purpose: 
A. Enables a BCP emergency shelter to record a youth that is not eligible under the FYSBRHY program and collect information about them. Upon reporting to RHY for the federal
transfer, RHY is then able to remove these youth from their program and congressional
reports.
B. Facilitates the local CoC and HMIS to utilize participation in BCP as part of their point-intime and other counts and measures.
C. Identifies the number of runaway youth.""" ;
    dcterms:identifier "R2" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onClass skos:Concept ;
            owl:onProperty :EligibleForRHY ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty :DateOfBCPStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :ProjectID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom :string32 ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom :string32 ] ;
    :CSVTableReference "Enrollment" .

:User a owl:Class ;
    dcterms:description "The unique identifier for User.csv is 5.07.1 UserID; the UserID in this file is used to associate data in other CSV files with a specific user, whether active or inactive at the time of the export. User.csv must include user information for all users included in other tables in the same CSV files. Additional export protocols may be established locally. This file includes fields that are not defined in the HMIS Data Dictionary: UserFirstName, UserLastNameUserPhone, UserExtension, UserEmail." ;
