:Event a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :EventID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty :EventDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ] ;
    :CSVTableReference "Event" .

:4.04.A a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "Applied; client not eligible" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "Applied; decision pending" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "Client did not apply" ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "Client doesn’t know" ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first "Client prefers not to answer" ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first "Data not collected" ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first "Insurance type n/a for this client" ;
                                                                    rdf:rest [ a rdf:List ;
                                                                            rdf:first 1 ;
                                                                            rdf:rest [ a rdf:List ;
                                                                                    rdf:first 2 ;
                                                                                    rdf:rest [ a rdf:List ;
                                                                                            rdf:first 3 ;
                                                                                            rdf:rest [ a rdf:List ;
                                                                                                    rdf:first 4 ;
                                                                                                    rdf:rest [ a rdf:List ;
                                                                                                            rdf:first 8 ;
                                                                                                            rdf:rest [ a rdf:List ;
                                                                                                                    rdf:first 9 ;
                                                                                                                    rdf:rest [ a rdf:List ;
                                                                                                                            rdf:first 99 ;
                                                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] .

:Assessment a owl:Class ;
    dcterms:description """This contains part of data element 4.19, Coordinated Entry Assessment. Because each assessment 
has some standard information exported in this file, but also any number of non-standard questions, 
responses, and results, the latter data are reported separately in AssessmentQuestions.csv and 
AssessmentResults.csv. This allows for the number of questions/responses and results to be a variable 
number, though there must be at least 1 row each in AssessmentQuestions.csv and AssessmentResults.csv for 
each row in Assessment.csv""" ;
    dcterms:identifier 4.19 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :AssessmentID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ] ;
    :CSVTableReference "Assessment" .

:InformationDate a owl:DatatypeProperty ;
    dcterms:description "Information Date" ;
    dcterms:identifier "5.04.1" ;
    rdfs:domain :Metadata ;
    rdfs:range xsd:date .

:CEParticipation a owl:Class ;
    dcterms:description "Includes information from 2.09 CE Participation." ;
    dcterms:identifier 2.09 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :ProjectID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :CEParticipationID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ] ;
    :CSVTableReference "CEParticipation" .

:NonCashBenefits a owl:Class ;
    dcterms:description "used to indicate which mainstream benefits persons are accessing at a point in time and to track changes in benefit access over time." ;
    dcterms:identifier 4.03 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :IncomeBenefitsID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onDataRange :5.03.1 ;
            owl:onProperty :DataCollectionStage ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange :1.8 ;
            owl:onProperty :BenefitsFromAnySource ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ] ;
    :CSVTableReference "IncomeBenefits" .

:ProjectCoC a owl:Class ;
    dcterms:description """Includes data for data element 2.03 Continuum of Care Code. There may be, but
do not have to be, multiple records in ProjectCoC.csv for each record in Project.csv where
ContinuumProject is equal to 1 (Yes).""" ;
    dcterms:identifier 2.03 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onDataRange <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#cocCode> ;
            owl:onProperty :CoCCode ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :ProjectCoCID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ProjectID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ] ;
    :CSVTableReference "ProjectCoC" .

:TypeProvided a owl:DatatypeProperty ;
    dcterms:description "For RecordType 141 – list P1.2; for 142 – list R14.2;For RecordType 143 – list W1.2;For RecordType 144 – list V2.2;For RecordType 151 – list W2.2;For RecordType 152 – list V3.4;For RecordType 161 – list P2.2;For RecordType 200 – list 4.14;For RecordType 210 – list V8.2;For RecordType 300 – list C2.2" ;
    rdfs:domain :ServiceFAReferral ;
    rdfs:range :4.14,
        :C2.2,
        :P1.2,
        :P2.2,
        :R14.2,
        :V2.2,
        :V3.4,
        :V8.2,
        :W1.2,
        :W2.2 ;
    hmis:responseValue """V3.4: 1=Rental assistance;10=Child care;2=Security deposit;3=Utility deposit;4=Utility fee payment assistance;5=Moving costs;8=Transportation services: tokens/vouchers;9=Transportation services: vehicle repair/maintenance;12=General housing stability assistance;14=Emergency housing assistance;15=Shallow Subsidy –Financial Assistance;16=Food assistance;17=Landlord Incentive;18=Tenant Incentive.

P1.2: 1=Re-engagement;10=Housing eligibility determination;11=Security deposits;
12=One-time rent for eviction prevention;14=Clinical assessment;2=Screening;
3=Habilitation/rehabilitation;4=Community mental health;5=Substance use treatment;
6=Case management;7=Residential supportive services;8=Housing minor renovation; 9=Housing moving assistance.

4.1.4: 200=BedNight

P2.2: 1=Community mental health;10=Medical insurance;11=Temporary housing;
2=Substance use treatment;3=Primary health/dental care;4=Job training;
5=Educational services;6=Housing services;7=Permanent housing;8=Income assistance;9=Employment assistance.

W1.2: 1=Adult day care and personal assistance;2=Case management;
3=Child care;4=Criminal justice/legal services;10=Mental health care/counseling;
11=Outreach and/or engagement;12=Substance use services/treatment;
13=Transportation;14=Other HOPWA funded service;5=Education;
6=Employment and training services;7=Food/meals/nutritional services;8=Health/medical care;9=Life skills training.

R14.2: 10=Parenting education for youth with children;12=Post-natal care for client (person who gave birth);13=Pre-natal care;14=Health/medical care;2=Community service/service learning (CSL);5=Education;6=Employment and/or training services;
7=Criminal justice /legal services;8=Life skills training;17=Substance use disorder treatment;18=Substance use disorder Ed/Prevention Services;26=Home-based Services;27=Post-natal newborn care (wellness exams; immunizations);28=STD Testing;29=Street-based Services.

V2.2: 1=Outreach services;2=Case management services;3=Assistance obtaining VA benefits;4=Assistance obtaining/coordinating other public benefits;5=Direct provision of other public benefits;6=Other (non-TFA) supportive service approved by VA;7=Shallow Subsidy;8=Returning Home;9=Rapid Resolution;10=Healthcare navigation.

V8.2: 1=Referral package forwarded to PHA;10=Veteran exited – family maintained the voucher;11=Veteran exited – prior to ever receiving a voucher;12=Other;2=Voucher denied by PHA;3=Voucher issued by PHA;4=Voucher revoked or expired;5=Voucher in use – veteran moved into housing;6=Voucher was ported locally;7=Voucher was administratively absorbed by new PHA;8=Voucher was converted to Housing Choice Voucher;9=Veteran exited – voucher was returned.

C2.2: 1=Subsidized housing application assistance;2=Financial assistance for Moving On;3=Non-financial assistance for Moving On;4=Housing referral/placement; 5=Other (please specify).

W2.2: 1=Rental assistance;2=Security deposits;3=Utility deposits;4=Utility payments; 7=Mortgage assistance.""" ;
    hmis:responseValueSecondary "" .

:CurrentLivingSituationClass a owl:Class ;
    dcterms:description """Contains data exclusively for element 4.12 which was previously
reported as contact events in Services.csv. This element now contains additional information and therefore requires a separate file.""" ;
    dcterms:identifier 4.12 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onDataRange :3.12.1 ;
            owl:onProperty :CurrentLivingSituation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :CurrentLivingSitID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty :InformationDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :DateDeleted ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ] ;
    :CSVTableReference "CurrentLivingSituation" .

:DataCollectionStage a owl:DatatypeProperty ;
    dcterms:description "Data Collection Stage" ;
    dcterms:identifier "5.03.1" ;
    rdfs:domain :Metadata ;
    rdfs:range :5.03.1 ;
    hmis:responseValue "1=Project entry;2=Update;3=Project exit;5=Annual assessment" .

:Exit a owl:Class ;
    dcterms:description "Includes enrollment information pertaining exclusively to the project exit data collection stage. Separated from Enrollment table to preserve metadata pertaining to the exit data collection stage." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :UserID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :DateCreated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :ExportID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :ExitID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onProperty :PersonalID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty :ExitDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty :DateUpdated ;
            owl:someValuesFrom xsd:dateTime ],
        [ a owl:Restriction ;
            owl:onProperty :EnrollmentID ;
            owl:someValuesFrom <https://raw.githubusercontent.com/hmis-interop/xml/FY2022-latest/src/HUD_HMIS.xsd#string32> ],
        [ a owl:Restriction ;
