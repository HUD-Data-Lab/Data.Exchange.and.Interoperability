hmis:LeaseOwn60DayShape
    a sh:NodeShape ;
    sh:targetClass hmis:CurrentLivingSituation ;

    sh:property [
        sh:path hmis:LeaseOwn60Day ;

        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;

        sh:node [
            sh:property [
                sh:path skos:inScheme ;
                sh:hasValue hmis:NoYesReasonsForMissing ;
            ]
        ] ;

        sh:message "LeaseOwn60Day must be a valid value from the NoYesReasonsForMissing vocabulary." ;
    ] .

