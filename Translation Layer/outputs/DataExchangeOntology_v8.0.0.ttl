@prefix hmis: <http://www.semanticweb.org/ontologies/hmis#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix de: <http://www.semanticweb.org/ontologies/hmis/de#> .

de:Scenario a owl:Class ;
  rdfs:label "Test scenario for Data Exchange Scenarios"@en .

de:httpMethod
  rdf:type owl:AnnotationProperty .

de:requestElement
  rdf:type owl:AnnotationProperty .

de:responseElement
  rdf:type owl:AnnotationProperty .

de:ClientSearchScenario
    rdf:type owl:Class ;
    rdfs:subClassOf de:Scenario ;
    de:httpMethod "Get" ;
