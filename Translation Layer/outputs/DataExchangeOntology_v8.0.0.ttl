        hmis:AssessmentQuestion ,
        hmis:AssessmentAnswer ,
        hmis:AssessmentResultType ,
        hmis:AssessmentResult ,
        hmis:NameDataQuality ,
        hmis:SSNDataQuality ,
        hmis:DOBDataQuality ,
        hmis:Sex ,
        hmis:AmIndAKNative ,
        hmis:Asian ,
        hmis:BlackAfAmerican ,
        hmis:HispanicLatinao ,
        hmis:MidEastNAfrican ,
