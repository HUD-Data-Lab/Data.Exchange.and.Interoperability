    <http://www.w3.org/2000/01/rdf-schema#label> "API Parameter" .

<https://hmis.info/api#Parameter_personalID>
    a <https://hmis.info/api#Parameter> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "personalID parameter" ;
    <https://hmis.info/api#in> "path"^^<http://www.w3.org/2001/XMLSchema#string> ;
    <https://hmis.info/api#name> "personalID"^^<http://www.w3.org/2001/XMLSchema#string> ;
    <https://hmis.info/api#required> true .

