@base <localhost://> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://hmis.info/api>
    a <http://www.w3.org/2002/07/owl#Ontology> ;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Companion API module for describing generated HMIS API resources, endpoints, paths, methods, parameters, returned resources, included fields, and filter fields." ;
    <http://www.w3.org/2000/01/rdf-schema#label> "HMIS API Ontology Module" ;
    <http://www.w3.org/2002/07/owl#imports> <https://hmis.info/ontology> .

<https://hmis.info/api#Endpoint>
    a <http://www.w3.org/2002/07/owl#Class> ;
    <http://www.w3.org/2000/01/rdf-schema#comment> "A callable API operation such as GET /clients/{personalID}." ;
    <http://www.w3.org/2000/01/rdf-schema#label> "API Endpoint" .

<https://hmis.info/api#GetClientByPersonalID>
    a <https://hmis.info/api#Endpoint> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Get Client by Personal ID" ;
    <https://hmis.info/api#description> "Returns a selected client profile using the HMIS PersonalID as a path parameter."^^<http://www.w3.org/2001/XMLSchema#string> ;
    <https://hmis.info/api#filterField> <https://hmis.info/ontology#PersonalID> ;
    <https://hmis.info/api#includesField> <https://hmis.info/ontology#DOB>, <https://hmis.info/ontology#FirstName>, <https://hmis.info/ontology#LastName>, <https://hmis.info/ontology#PersonalID> ;
    <https://hmis.info/api#method> "GET"^^<http://www.w3.org/2001/XMLSchema#string> ;
    <https://hmis.info/api#parameter> <https://hmis.info/api#Parameter_personalID> ;
    <https://hmis.info/api#path> "/clients/{personalID}"^^<http://www.w3.org/2001/XMLSchema#string> ;
    <https://hmis.info/api#returns> <https://hmis.info/ontology#Client> ;
    <https://hmis.info/api#summary> "Return a client record by PersonalID."^^<http://www.w3.org/2001/XMLSchema#string> .

<https://hmis.info/api#GetProjectByProjectID>
    a <https://hmis.info/api#Endpoint> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Get Project by Project ID" ;
    <https://hmis.info/api#description> "Returns selected project metadata using the HMIS ProjectID as a path parameter."^^<http://www.w3.org/2001/XMLSchema#string> ;
    <https://hmis.info/api#filterField> <https://hmis.info/ontology#ProjectID> ;
    <https://hmis.info/api#includesField> <https://hmis.info/ontology#OperatingStartDate>, <https://hmis.info/ontology#ProjectID>, <https://hmis.info/ontology#ProjectName> ;
    <https://hmis.info/api#method> "GET"^^<http://www.w3.org/2001/XMLSchema#string> ;
    <https://hmis.info/api#path> "/projects/{projectID}"^^<http://www.w3.org/2001/XMLSchema#string> ;
    <https://hmis.info/api#returns> <https://hmis.info/ontology#Project> ;
    <https://hmis.info/api#summary> "Return a project record by ProjectID."^^<http://www.w3.org/2001/XMLSchema#string> .

<https://hmis.info/api#Parameter>
    a <http://www.w3.org/2002/07/owl#Class> ;
