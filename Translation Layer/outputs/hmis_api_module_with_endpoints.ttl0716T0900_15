<https://hmis.info/api#SearchEnrollments>
    a <https://hmis.info/api#Endpoint> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Search Enrollments" ;
    <https://hmis.info/api#description> "Returns enrollment records with selected identifying, project, and date fields."^^<http://www.w3.org/2001/XMLSchema#string> ;
    <https://hmis.info/api#filterField> <https://hmis.info/ontology#PersonalID>, <https://hmis.info/ontology#ProjectID> ;
    <https://hmis.info/api#includesField> <https://hmis.info/ontology#EnrollmentID>, <https://hmis.info/ontology#EntryDate>, <https://hmis.info/ontology#ExitDate>, <https://hmis.info/ontology#PersonalID>, <https://hmis.info/ontology#ProjectID> ;
    <https://hmis.info/api#method> "GET"^^<http://www.w3.org/2001/XMLSchema#string> ;
    <https://hmis.info/api#path> "/enrollments"^^<http://www.w3.org/2001/XMLSchema#string> ;
    <https://hmis.info/api#returns> <https://hmis.info/ontology#Enrollment> ;
    <https://hmis.info/api#summary> "Search enrollment records using supported filters."^^<http://www.w3.org/2001/XMLSchema#string> .

